# Copy to .env.local and fill in from your Supabase project settings (API section).
# Region for the project should be Mumbai (ap-south-1) per the design.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose to the browser. Used for admin branch provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
